{
  "name": "rf-web-simulator",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-initial-bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test tests/metadata-check.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@carbon/icons-react": "11.85.0",
    "@carbon/react": "1.113.0",
    "@ibm/plex": "6.4.1",
    "@xyflow/react": "12.11.2",
    "plotly.js-basic-dist-min": "3.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "24.13.3",
    "@types/plotly.js": "3.0.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "17.8.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "storybook": "^10.5.7",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
